{
  "name": "@nhtanvir/hookbench",
  "version": "0.1.0",
  "description": "Test MCP Events (SEP-3415) locally and in CI: a mock MCP Events client, a live inspector, a reference server and a conformance check for the Model Context Protocol events extension. Zero dependencies.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-events",
    "sep-3415",
    "mcp-server",
    "mcp-client",
    "mcp-testing",
    "mcp-inspector",
    "conformance",
    "conformance-testing",
    "testing",
    "webhooks",
    "standard-webhooks",
    "webhook-testing",
    "mock-server",
    "chatgpt",
    "ai-agents",
    "events",
    "cli"
  ],
  "license": "MIT",
  "author": "NHTanvir",
  "homepage": "https://github.com/NHTanvir/hookbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NHTanvir/hookbench.git"
  },
  "bugs": {
    "url": "https://github.com/NHTanvir/hookbench/issues"
  },
  "type": "module",
  "bin": {
    "hookbench": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test build/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "demo": "node dist/cli.js demo"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "typescript": "5.9.3"
  }
}
